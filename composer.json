{
    "name": "lifetwin/lifetwin-woocommerce",
    "description": "LifeTwin DPP integration for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "LifeTwin\\WooCommerce\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
